# Copy to .env.mainnet. Never commit the filled file or paste private keys into chat.
# Generate a new 32-byte encryption key locally; keep it stable across restarts.
# Also required when a Telegram Bot Token is stored from Settings.
GRID_TRADING_CREDENTIAL_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Add trading accounts in Settings → Exchange Accounts.
# Optional, one-time legacy import (omit when using the portal):
# GRID_TRADING_HL_MAINNET_ACCOUNT_ADDRESS=0x...
# GRID_TRADING_HL_MAINNET_AGENT_PRIVATE_KEY=0x...
# Start new strategies in the application. Existing active cycles resume after a backend restart.
